# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project Settings -> API. Both are safe to expose to the browser; row-level
# security is what protects the data, so never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint works — switching models is a config change,
# not a code change.
AI_PROVIDER=fireworks
AI_MODEL=accounts/fireworks/models/kimi-k3
AI_BASE_URL=https://api.fireworks.ai/inference/v1

# Server-side only. FIREWORKS_API_KEY is checked first, then AI_API_KEY.
FIREWORKS_API_KEY=your_api_key
# AI_API_KEY=your_api_key

# ---------------------------------------------------------------------------
# Guest sessions
# ---------------------------------------------------------------------------
# Cloudflare Turnstile site key. REQUIRED on any public deployment: guest
# sessions are a signup path with no email step, and each one carries its own
# allowance of calls against the server-side AI key above, so without a CAPTCHA
# minting unlimited sessions is a page reload. The matching SECRET key goes in
# Supabase under Authentication -> Attack Protection, which is what actually
# enforces the check. Leave unset locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Salt for the per-IP guest ceiling. Only a hash is ever stored — never the
# address itself — and the salt is what keeps that hash from being reversible,
# since the whole IPv4 space can be enumerated in seconds. Unset disables the
# per-IP layer entirely. Generate one with:
#   openssl rand -hex 32
IP_HASH_SECRET=

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# Optional app-side cap on AI calls per caller per rolling hour.
#
# The authoritative limits live in the public.ai_limits table, not here: the
# reservation function is reachable over PostgREST by any signed-in caller, so a
# value sent from the app can only ever make the cap STRICTER, never raise it.
# Use this to tighten a single deployment below the database default. Unset or
# 0 defers to the database entirely — leave it that way unless you need the
# override, or raising member_hourly_limit in the table will appear to do nothing.
AI_RATE_LIMIT_PER_HOUR=0

# Characters of extracted document text sent to the model in one call.
# Guards against a very long PDF blowing past the model's context window.
AI_MAX_DOC_CHARS=400000
